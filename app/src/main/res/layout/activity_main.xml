<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/member_registration"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />

        <EditText
            android:id="@+id/member_name_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/member_name_hint"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/member_color_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/member_color_hint"
            android:inputType="text" />

        <EditText
            android:id="@+id/member_card_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/member_card_hint"
            android:inputType="number"
            android:saveEnabled="false" />

        <EditText
            android:id="@+id/member_password_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/member_password_hint"
            android:inputType="textPassword"
            android:saveEnabled="false" />

        <Button
            android:id="@+id/register_member_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register_member" />

        <TextView
            android:id="@+id/registration_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes" />

        <Button
            android:id="@+id/manual_sync_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/manual_sync" />

        <TextView
            android:id="@+id/sync_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sync_waiting" />

        <TextView
            android:id="@+id/schedule_warning_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/notification_permission_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notification_permission" />

        <TextView
            android:id="@+id/notification_status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/members_heading"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />

        <TextView
            android:id="@+id/members_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loans_heading"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />

        <TextView
            android:id="@+id/loans_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reservations_heading"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />

        <TextView
            android:id="@+id/reservations_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shelves_heading"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />

        <TextView
            android:id="@+id/shelves_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/summaries_heading"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />

        <TextView
            android:id="@+id/summaries_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/last_sync_heading"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />

        <TextView
            android:id="@+id/last_sync_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/reading_records_heading"
            android:textAppearance="@android:style/TextAppearance.Material.Headline" />

        <TextView
            android:id="@+id/reading_records_count_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <EditText
            android:id="@+id/reading_records_search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/reading_records_search_hint"
            android:inputType="text" />

        <TextView
            android:id="@+id/reading_records_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
